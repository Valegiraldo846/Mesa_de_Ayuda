{
  "info": {
    "name": "04-Tickets-Soporte-Admin",
    "_postman_id": "a1b2c3d4-0000-4000-8000-000000000004",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Operaciones exclusivas de SOPORTE/ADMIN sobre tickets.\n- GET /api/tickets (listar todos) -> 200 con rol SOPORTE y -> 403 con USUARIO.\n- PATCH /api/tickets/{id}/estado -> 200 (EN_PROCESO con SOPORTE, RESUELTO con ADMIN) y estado invalido -> 400.\n- GET /api/tickets/vencidos -> 200 (SOPORTE) y -> 403 con USUARIO."
  },
  "item": [
    {
      "name": "GET /api/tickets (soporte) -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenSoporte}}"
          }
        ],
        "url": "{{baseUrl}}/api/tickets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listar todos los tickets (soporte) -> 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Respuesta es un arreglo', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH estado -> EN_PROCESO (soporte) -> 200",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenSoporte}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"estado\": \"EN_PROCESO\" }"
        },
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}/estado"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cambiar estado a EN_PROCESO -> 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Estado actualizado', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.estado).to.eql('EN_PROCESO');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH estado -> RESUELTO (admin) -> 200",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"estado\": \"RESUELTO\" }"
        },
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}/estado"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cambiar estado a RESUELTO (admin) -> 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Estado actualizado a RESUELTO', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.estado).to.eql('RESUELTO');",
              "    pm.expect(body.vencido).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/tickets/vencidos (soporte) -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenSoporte}}"
          }
        ],
        "url": "{{baseUrl}}/api/tickets/vencidos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Tickets vencidos (soporte) -> 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Respuesta es un arreglo', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/tickets (usuario) -> 403",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenUsuario}}"
          }
        ],
        "url": "{{baseUrl}}/api/tickets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('USUARIO no puede listar todos -> 403', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH estado invalido (CERRADO) -> 400",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenSoporte}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"estado\": \"CERRADO\" }"
        },
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}/estado"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado fuera del enum -> 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/tickets/vencidos (usuario) -> 403",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenUsuario}}"
          }
        ],
        "url": "{{baseUrl}}/api/tickets/vencidos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('USUARIO no consulta tickets vencidos -> 403', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}