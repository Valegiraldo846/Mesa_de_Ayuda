    {
      "name": "Registro: email duplicado -> 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"nombre\": \"Usuario Test\", \"email\": \"usuario@test.com\", \"password\": \"usuario123\" }"
        },
        "url": "{{baseUrl}}/api/auth/registro"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Email duplicado -> 409 Conflict', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test('Mensaje de error', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.error).to.eql('El email ya est\u00e1 registrado');",
              "});"
            ]
          }
        }
      ]
    },
