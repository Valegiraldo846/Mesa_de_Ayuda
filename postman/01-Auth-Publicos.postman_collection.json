    {
      "name": "Login: usuario -> 200 (guarda tokens)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"usuario@test.com\", \"password\": \"usuario123\" }"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login usuario -> 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Guarda accessToken y refreshToken del usuario', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.accessToken).to.not.be.empty;",
              "    pm.expect(body.refreshToken).to.not.be.empty;",
              "    pm.environment.set('tokenUsuario', body.accessToken);",
              "    pm.environment.set('refreshUsuario', body.refreshToken);",
              "});"
            ]
          }
        }
      ]
    },
