    {
      "name": "Refresh: renovar access token -> 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"refreshToken\": \"{{refreshSoporte}}\" }"
        },
        "url": "{{baseUrl}}/api/auth/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Refresh token valido -> 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Devuelve nuevo accessToken y actualiza entorno', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.accessToken).to.not.be.empty;",
              "    pm.environment.set('tokenSoporte', body.accessToken);",
              "});"
            ]
